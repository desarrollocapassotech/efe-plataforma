# URL de la API de Faktia (facturación electrónica), incluyendo el prefijo /api. Sin barra final.
# Ej. local: http://localhost:3000/api  ·  producción: https://<backend-faktia>/api
VITE_FAKTIA_API_URL=https://facturador-backend-i8dl.onrender.com/api

# Panel web de Faktia (botón "Abrir Faktia" en Facturas). Sin barra final.
VITE_FAKTIA_APP_URL=https://facturador-frontend-s6oi.onrender.com

# URL de la API de la plataforma EFE (@efe/api), con el prefijo /api/v1. Sin barra final.
# Ej. local: http://localhost:3000/api/v1. Las secciones Usuarios plataforma, Métricas,
# Indicadores y Auditoría la usan con el ID token de Firebase (el usuario tiene que ser ADMIN).
VITE_API_URL=http://localhost:3000/api/v1
