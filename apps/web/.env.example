# Web de usuarios — variables de entorno (docs/ARCHITECTURE.md §10)
# Copiá este archivo a .env.local. Son valores públicos (terminan en el bundle del navegador),
# pero igual no se commitea el .env.local.

# URL base de la API, con el prefijo /api/v1.
VITE_API_URL=http://localhost:3000/api/v1

# Config de la Web app de Firebase (proyecto efecapitaladmin → Configuración → Tus apps).
# Pendiente (paso 0.4): registrar la web app "EFE Web". Mientras tanto sirve la del admin.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=efecapitaladmin.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=efecapitaladmin
VITE_FIREBASE_APP_ID=

# Sentry (paso 7.1).
VITE_SENTRY_DSN=
