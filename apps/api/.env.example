# API de la plataforma EFE — variables de entorno (docs/ARCHITECTURE.md §10)
# Copiá este archivo a .env (desarrollo) y a .env.test (tests e2e). Nunca commitees los reales.

# development | test | production
NODE_ENV=development
PORT=3000
# fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# --- Base de datos (Neon) -----------------------------------------------------
# Igual que Vialto: producción y desarrollo en proyectos de Neon SEPARADOS (la cuota de
# cómputo es por proyecto: el uso de desarrollo no puede suspender producción).
#   - Desarrollo local: proyecto `efe-plataforma-desarrollo`, rama `develop`.
#   - Tests e2e (.env.test): mismo proyecto, rama `test`.
#   - Producción (Render): proyecto `efe-plataforma`, rama `production`.
# DATABASE_URL: conexión con pooler (host con `-pooler`), la usa la app.
DATABASE_URL=postgresql://USUARIO:PASSWORD@ep-xxxx-pooler.c-2.sa-east-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require
# DIRECT_URL: conexión directa (sin `-pooler`), la usa Prisma para migraciones.
DIRECT_URL=postgresql://USUARIO:PASSWORD@ep-xxxx.c-2.sa-east-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# --- Tests e2e (.env.test) ----------------------------------------------------
# Alternativa sin Neon: `docker compose up db` y en .env.test
# DATABASE_URL=postgresql://efe:efe@localhost:5433/efe_test
# DIRECT_URL=postgresql://efe:efe@localhost:5433/efe_test

# --- Firebase Admin (proyecto efecapitaladmin) ----------------------------------
# Obligatorias (salvo NODE_ENV=test, donde los e2e usan tokens de prueba).
# Salen del JSON de la service account. La private key va entre comillas con los \n literales.
FIREBASE_PROJECT_ID=efecapitaladmin
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# --- HTTP ---------------------------------------------------------------------
# Orígenes permitidos, separados por coma. Default en desarrollo: web (5173) y admin (5174).
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# --- Jobs (paso 2.3) ----------------------------------------------------------
# Header X-Jobs-Secret de los crons. Mínimo 32 caracteres. Obligatoria en producción.
# Generalo con: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
JOBS_SECRET=

# --- Observabilidad -----------------------------------------------------------
SENTRY_DSN=

# --- Seed (pnpm --filter @efe/api prisma db seed) ------------------------------
# Usuarios ADMIN. Varios separados por coma, emparejados por posición.
# El UID está en Firebase Console → Authentication → Users (proyecto efecapitaladmin).
SEED_ADMIN_FIREBASE_UID=
SEED_ADMIN_EMAIL=
