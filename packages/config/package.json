{
  "name": "@efe/config",
  "version": "0.0.0",
  "private": true,
  "description": "Configuración compartida: tsconfig, ESLint y preset de Tailwind con los tokens de EFE",
  "type": "module",
  "exports": {
    "./tsconfig/base.json": "./tsconfig/base.json",
    "./tsconfig/node.json": "./tsconfig/node.json",
    "./tsconfig/react.json": "./tsconfig/react.json",
    "./eslint": "./eslint/base.js",
    "./eslint/react": "./eslint/react.js",
    "./tailwind": {
      "types": "./tailwind/preset.d.ts",
      "default": "./tailwind/preset.js"
    }
  },
  "scripts": {
    "lint": "eslint ."
  },
  "dependencies": {
    "@eslint/js": "^10.0.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "typescript-eslint": "^8.74.0",
    "tailwindcss-animate": "^1.0.7"
  },
  "peerDependencies": {
    "eslint": "^10.0.0",
    "tailwindcss": "^3.4.0",
    "typescript": ">=5.5 <6.1"
  },
  "devDependencies": {
    "eslint": "^10.15.0",
    "tailwindcss": "^3.4.19"
  },
  "peerDependenciesMeta": {
    "tailwindcss": {
      "optional": true
    }
  }
}
